# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Host application URL
APP_URL="http://localhost:3000"

# SERVER CONFIGURATION
PORT=3000
NODE_ENV="development"

# JWT CONFIGURATION
# Generate high entropy secret in production: openssl rand -base64 48
JWT_SECRET="authguard-super-secret-jwt-key-change-in-production-2026"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="authguard-refresh-secret-jwt-key-change-in-production-2026"
JWT_REFRESH_EXPIRES_IN="7d"

# BCRYPT SECURITY
BCRYPT_SALT_ROUNDS=12

# DATABASE CONFIGURATION
# Production database connection string (e.g., PostgreSQL or MySQL)
DATABASE_URL="postgres://postgres:password@localhost:5432/authguard_db"

# EMAIL VERIFICATION & PASSWORD RESET CONFIGURATION
TOKEN_EXPIRY_HOURS=24
RESET_TOKEN_EXPIRY_HOURS=1

# SMTP CONFIGURATION (Production Email Provider, e.g., SendGrid / AWS SES / Mailgun)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER="smtp_username"
SMTP_PASS="smtp_password"
EMAIL_FROM="AuthGuard Security <noreply@authguard.app>"
